# ==============================================================================
# ProcureYeti Celo - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development and post-deployment:
#   cp .env.example .env.local
#
# NOTE: Never commit .env.local, private keys, or seed phrases to version control.
# .env* is excluded in .gitignore.
# ==============================================================================

# 1. On-Chain ProcureYetiDisburser Address (Celo Sepolia Testnet - Chain ID: 11142220)
# Set this after deploying ProcureYetiDisburser.sol to Celo Sepolia:
NEXT_PUBLIC_DISBURSER_ADDRESS=

# 2. Network RPC Configuration (Optional override; defaults to Forno Celo Sepolia RPC)
NEXT_PUBLIC_CELO_SEPOLIA_RPC=https://forno.celo-sepolia.celo-testnet.org
NEXT_PUBLIC_CHAIN_ID=11142220

# 3. Optional: Deployer Signer Private Key
# ONLY required if using `node scripts/deploy-disburser.js --broadcast`.
# Must be an account funded with testnet CELO on Celo Sepolia (https://faucet.celo.org).
# Keep strictly secret and never commit to repository.
# DEPLOYER_PRIVATE_KEY=0x...
