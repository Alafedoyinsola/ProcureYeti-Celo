
# ==============================================================================
# ProcureYeti Celo - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   Copy-Item .env.example .env.local
#
# Never commit .env.local, private keys, or seed phrases.
# ==============================================================================

# 1. ProcureYetiDisburser contract address
# Leave empty until a verified Celo Mainnet deployment exists.
NEXT_PUBLIC_DISBURSER_ADDRESS=

# 2. Celo Network Configuration
# Celo Mainnet: Chain ID 42220
NEXT_PUBLIC_CHAIN_ID=42220

# 3. Optional deployer private key
# Only required for an explicitly authorized contract deployment.
# Never commit or expose this key.
# DEPLOYER_PRIVATE_KEY=0x...
